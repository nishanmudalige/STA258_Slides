<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>STA258 Slides Website Help Manual</title>

  <style>
    :root {
      --sta-navy: #153e75;
      --sta-blue: #2563a9;
      --sta-blue-soft: #eef6ff;
      --sta-blue-border: #9dc5f5;
      --sta-teal: #00695c;
      --sta-teal-dark: #004d40;
      --sta-yellow: #fff4d6;
      --sta-orange: #f6a800;
      --sta-border: #d8dee4;
      --sta-text: #171b35;
      --sta-muted: #536b78;
      --sta-code-bg: #f3f5ff;
      --sta-code-border: #b8c4f5;
      --sta-code-text: #27314f;
      --sta-dark-code: #202336;
    }

    * {
      box-sizing: border-box;
    }

    body {
      max-width: 900px;
      margin: 0 auto;
      padding: 42px 28px 80px 28px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.62;
      color: var(--sta-text);
      background: #ffffff;
    }

    h1 {
      color: var(--sta-navy);
      font-size: 32px;
      font-weight: 800;
      margin: 0 0 12px 0;
      padding-bottom: 12px;
      border-bottom: 3px solid var(--sta-blue);
      letter-spacing: -0.02em;
    }

    .authors {
      font-weight: 600;
      color: var(--sta-muted);
      margin: 0 0 26px 0;
    }

    h2 {
      color: var(--sta-navy);
      font-size: 22px;
      font-weight: 800;
      margin-top: 42px;
      margin-bottom: 16px;
      padding-left: 12px;
      border-left: 4px solid var(--sta-blue);
      line-height: 1.25;
    }

    h3 {
      color: #34444c;
      font-size: 17px;
      font-weight: 800;
      margin-top: 28px;
      margin-bottom: 10px;
    }

    p {
      margin-top: 0;
      margin-bottom: 16px;
    }

    a {
      color: var(--sta-blue);
      text-decoration: underline;
      text-underline-offset: 2px;
      font-weight: 500;
    }

    ul, ol {
      margin-top: 0;
      margin-bottom: 20px;
      padding-left: 28px;
    }

    li {
      margin-bottom: 6px;
    }

    strong {
      font-weight: 800;
    }

    code {
      background: var(--sta-code-bg);
      color: var(--sta-code-text);
      border: 1px solid var(--sta-code-border);
      padding: 1px 6px;
      border-radius: 4px;
      font-family: Consolas, Monaco, "Courier New", monospace;
      font-size: 0.93em;
      white-space: nowrap;
    }

    pre {
      background: var(--sta-dark-code);
      color: #edf1ff;
      border-radius: 7px;
      padding: 16px 18px;
      overflow-x: auto;
      font-family: Consolas, Monaco, "Courier New", monospace;
      font-size: 14px;
      line-height: 1.55;
      margin: 16px 0 24px 0;
      white-space: pre;
      border: 1px solid #191a2a;
    }

    pre code {
      background: transparent;
      border: none;
      color: inherit;
      padding: 0;
      border-radius: 0;
      font-size: inherit;
      white-space: inherit;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 18px 0 28px 0;
      font-size: 15px;
    }

    th {
      background: var(--sta-navy);
      color: white;
      text-align: left;
      padding: 10px 12px;
      font-weight: 800;
      border: 1px solid var(--sta-navy);
    }

    td {
      padding: 10px 12px;
      border: 1px solid #d9d9d9;
      vertical-align: top;
    }

    tr:nth-child(even) td {
      background: #f2f2f2;
    }

    tr:nth-child(odd) td {
      background: #ffffff;
    }

    .toc-box {
      background: var(--sta-blue-soft);
      border: 1px solid var(--sta-blue-border);
      border-radius: 6px;
      padding: 18px 24px;
      margin: 18px 0 36px 0;
    }

    .toc-title {
      color: var(--sta-navy);
      font-weight: 800;
      margin-bottom: 12px;
    }

    .toc-box ol {
      margin-bottom: 0;
    }

    .toc-box li {
      margin-bottom: 6px;
    }

    .note {
      background: var(--sta-yellow);
      border-left: 4px solid var(--sta-orange);
      border-radius: 4px;
      padding: 13px 16px;
      margin: 18px 0 24px 0;
    }

    .warning {
      background: #fff1e5;
      border-left: 4px solid #ef6c00;
      border-radius: 4px;
      padding: 13px 16px;
      margin: 18px 0 24px 0;
    }

    .file-card {
      background: #ffffff;
      border: 1px solid var(--sta-border);
      border-left: 4px solid var(--sta-blue);
      border-radius: 6px;
      padding: 14px 16px;
      margin: 14px 0 18px 0;
    }

    .file-card h3 {
      margin-top: 0;
      color: var(--sta-navy);
    }

    .footer {
      margin-top: 48px;
      padding-top: 18px;
      border-top: 1px solid #777;
      color: #8aa0ad;
      font-weight: 600;
      font-size: 14px;
    }

    @media (max-width: 700px) {
      body {
        padding: 28px 18px 60px 18px;
      }

